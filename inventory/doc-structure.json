        "platform/",
        "operations/",
        "architecture/",
        "features/",
        "agents/",
        "archive/"
      ]
    },
    "omai": {
      "hub_path": "/var/www/omai/docs",
      "folders": [
        "README.md",
        "om-brain/",
        "coordination/",
        "governance/",
        "operations/",
        "deployment/",
        "archive/"
      ]
    }
  },
  "path_rules": [
    { "match": "/docs/om-brain/", "category": "om-brain", "repo": "omai" },
    { "match": "/om-brain/", "category": "om-brain", "repo": "omai" },
    { "match": "/docs/coordination/", "category": "coordination", "repo": "omai" },
    { "match": "/docs/governance/", "category": "coordination", "repo": "omai" },
    { "match": "/docs/operations/", "category": "operations", "repo": "omai" },
    { "match": "/docs/deployment/", "category": "operations", "repo": "omai" },
    { "match": "/docs/platform/", "category": "platform", "repo": "om" },
    { "match": "/docs/operations/", "category": "operations", "repo": "om" },
    { "match": "/docs/architecture/", "category": "platform", "repo": "om" },
    { "match": "/docs/features/", "category": "platform", "repo": "om" },
    { "match": "/docs/agents/", "category": "agents", "repo": "om" },
    { "match": "/docs/archive/", "category": "archive", "repo": "om" },
    { "match": "/archive/", "category": "archive" },
    { "match": "/6-26-26/", "category": "archive" },
    { "match": "/6-27-26/", "category": "archive" },
    { "match": "AGENTS.md", "category": "agents" },
    { "match": "CLAUDE.md", "category": "agents" }
  ]
