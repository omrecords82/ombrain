      "id": "platform",
      "label": "Platform topology & boundaries",
      "description": "Host maps, data model, cross-repo boundaries, architecture overviews."
    },
    {
      "id": "operations",
      "label": "Operations & deploy",
      "description": "Runbooks, deploy scripts, env contracts, verification playbooks."
    },
    {
      "id": "om-brain",
      "label": "OM Brain",
      "description": "Brain architecture, memory layers, skills, RAG, calendar, API surfaces."
    },
    {
      "id": "coordination",
