# getbrain — LAN bootstrap service for the `ombrain` CLI
# Copy to /etc/om-brain/getbrain.env on om-prod01 (.239) and edit.

# Listen socket (nginx proxies orthodoxmetrics.com/getbrain -> here)
GETBRAIN_PORT=8395
GETBRAIN_BIND=127.0.0.1

# REQUIRED: shared bootstrap PIN the operator types on the page.
# Pick something non-trivial; rotate by editing this and restarting.
GETBRAIN_PIN=change-me

# Who may reach the service (client IP / CIDR allowlist, comma-separated).
GETBRAIN_ALLOW_CIDR=192.168.1.0/24,127.0.0.1/32

# The Brain endpoint the installed ombrain will target (master host + port(s)).
# Production uses the single LAN API port 8390 (nginx edge -> 127.0.0.1:8390).
# A port range (e.g. 60000-62000) is supported for future worker-pool setups.
GETBRAIN_BRAIN_HOST=192.168.1.254
GETBRAIN_BRAIN_PORTS=8390

# Public base path used to build the install one-liner (must match nginx).
GETBRAIN_PUBLIC_BASE=http://orthodoxmetrics.com/getbrain

# Token lifetime (ms) and PIN attempt cap per IP per 15 min.
GETBRAIN_TOKEN_TTL_MS=600000
GETBRAIN_MAX_ATTEMPTS=5

# Optional explicit asset paths (default: resolved from the repo layout).
# GETBRAIN_ASSET_CLI=/var/www/omai/om-brain/bin/ombrain.js
# GETBRAIN_ASSET_INSTALLER=/var/www/omai/om-brain/deploy/install-ombrain.sh
