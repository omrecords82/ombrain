# /etc/om-brain/om-brain.env — production environment for om-brain.service on auth01.
# Copy to /etc/om-brain/om-brain.env, chmod 0640, chown root:om-brain.
# NEVER commit a filled-in copy. Secrets governance is a human-only domain.

NODE_ENV=production

# --- HTTP API (bind to localhost only; expose via OMStudio/reverse proxy if ever needed) ---
BRAIN_HTTP_HOST=127.0.0.1
BRAIN_HTTP_PORT=8390

# --- Local inference (auth01-local Ollama). MUST be loopback/LAN only. ---
# The circuit breaker hard-blocks api.openai.com and any non-RFC1918 host in prod.
BRAIN_LLM_BASE_URL=http://127.0.0.1:11434/v1
BRAIN_LLM_API_KEY=local-no-key
BRAIN_LLM_REASONING_MODEL=qwen2.5:7b-instruct-q4_K_M
BRAIN_LLM_CLASSIFIER_MODEL=qwen2.5:3b-instruct-q4_K_M
BRAIN_LLM_EMBEDDING_MODEL=nomic-embed-text
BRAIN_LLM_TIMEOUT_MS=180000

# --- Memory (SQLite under StateDirectory) ---
BRAIN_DB_PATH=/var/lib/om-brain/brain.db
BRAIN_DOCTRINE_PATH=/opt/om-brain/src/doctrine/om-doctrine-0001.md
BRAIN_EMBEDDING_DIM=768

# --- Read-only ingestion adapters (OFF by default; enable after JWT provisioned) ---
OM_API_BASE_URL=http://192.168.1.239:7060
# Provision a READ-ONLY ops JWT out-of-band. The variable NAME is documented;
# the value is a secret and must never be logged.
#
# Use the dedicated brain_ingest service account (NOT omsvc@ super_admin):
#   set -a && source /var/www/omai/.env.omai && set +a
#   sudo -E om-brain/deploy/provision-brain-ingest.sh --update-auth01
# Scopes: GET /api/platform/events, GET /api/deploy-runs, GET /api/platform/inventory,
#         WS /ws/omai-logger (Bearer on :7060 only).
BRAIN_OPS_JWT=
BRAIN_ENABLE_EVENT_ADAPTER=false
BRAIN_ENABLE_INVENTORY_ADAPTER=false
BRAIN_ENABLE_LOG_ADAPTER=false
BRAIN_EVENTS_POLL_MS=30000
BRAIN_INVENTORY_POLL_MS=60000
BRAIN_LOG_WS_URL=ws://192.168.1.239:7060/ws/omai-logger
# WS on :7060 requires Authorization: Bearer <BRAIN_OPS_JWT> (brain_ingest role).
# Browser/nginx clients continue to use :443 → :3001 without Bearer.

# --- OMStudio governance integration (governed; Annex A §G) ---
# Default is dry-run so the service is safe out of the box. To go live, set
# OMSTUDIO_TRANSPORT=http and point the base URL at the LAN edge address so the
# circuit breaker (LAN/RFC1918 only) permits it. Confirm the ASSUMED REST
# contract in src/governance/omstudioClient.js against the live OMStudio API
# first (see docs/OMSTUDIO-INTEGRATION.md).
OMSTUDIO_TRANSPORT=dryrun
# For http transport in production use the LAN edge, e.g.:
#   OMSTUDIO_GOVERNANCE_BASE_URL=http://192.168.1.242/omstudio-embed
OMSTUDIO_GOVERNANCE_BASE_URL=http://192.168.1.242/omstudio-embed
# Governed service token (bearer header only; NEVER logged). Provision out-of-band.
OMSTUDIO_SERVICE_TOKEN=
# Dry-run outbox lives under the service StateDirectory.
OMSTUDIO_OUTBOX_DIR=/var/lib/om-brain/omstudio-outbox

# --- Webhook nginx (Fork A §4 — auth01 only; see deploy/WEBHOOK-NGINX.md) ---
# OMStudio (.242) POSTs to http://192.168.1.254:8391/governance/approvals/:id/ingest-status
# after `sudo om-brain/deploy/install-webhook-nginx.sh` on auth01.
