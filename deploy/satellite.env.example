# /etc/om-brain/satellite.env — fleet satellite on om-prod01 (.239)
# Copy to satellite host, chmod 0640.

# NATS broker on om-dev (.254) — LAN only
NATS_URL=nats://192.168.1.254:4222
# NATS_TOKEN=  # optional; must match broker + brain env

# This host's inventory id (must match inventory/hosts.json name)
SATELLITE_HOST_ID=om-prod01

# Handler scripts root on satellite
OM_BRAIN_ROOT=/opt/om-brain

# Per-handler timeout (ms)
# FLEET_NATS_TIMEOUT_MS=120000
