[Unit]
Description=LiteLLM Proxy Service (Brain external model gateway)
After=network.target

[Service]
User=next
Group=next
EnvironmentFile=/etc/litellm/litellm.env
ExecStart=/home/next/.local/bin/litellm --config /etc/litellm/config.yaml --port 4000 --host 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
