{
  "name": "om-brain-console",
  "version": "1.0.0",
  "private": true,
  "description": "Dedicated OMBrain Command Console — LAN operator UI on om-dev (.254)",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "start": "NODE_ENV=production node server/index.js",
    "deploy:254": "bash deploy/deploy-to-254.sh"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
