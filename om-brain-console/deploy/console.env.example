# om-brain-console environment — install as /etc/om-brain/console.env
#
# Auth model:
#   - LAN nginx allowlist (192.168.1.0/24) is the primary gate.
#   - Optional CONSOLE_AUTH_TOKEN adds Bearer / X-Console-Token on API + UI routes.
#   - Leave CONSOLE_AUTH_TOKEN empty for LAN-trust-only (internal subnet).

CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8392
OM_BRAIN_URL=http://127.0.0.1:8390
NODE_ENV=production

# Optional shared secret for console UI/API (unset = LAN trust only)
# CONSOLE_AUTH_TOKEN=

# Optional — forwarded to om-brain when required by upstream routes
# OMSTUDIO_SERVICE_TOKEN=

# Optional OMAI proxy activity panel (best effort, non-blocking)
OMAI_BRAIN_ACTIVITY_URL=http://192.168.1.239:7060/api/brain/activity
# OMAI_BRAIN_ACTIVITY_TOKEN=
OMAI_ACTIVITY_TIMEOUT_MS=3000
